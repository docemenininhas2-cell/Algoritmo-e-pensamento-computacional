# include <stdio.h>

int main () {

float temperatura;
int opcao;
float resultado;

printf("Opção 1. Celsius para fahreheint: \n");
printf("Opção 2. Celsius para kelvin: \n");
printf("Opção 3. Fahreheint para celsius: \n");
printf("Opção 4. Fahreheint para kelvin: \n");
printf("Opção 5. Kelvin para celsius: \n");
printf("Opção 6. Kelvin para fahreheint: \n");
printf("Escolha uma opção: ");
scanf("%d", &opcao);

switch (opcao) {
    
    case 1:
    printf("Digite os graus da temperatura: ");
    scanf("%f", &temperatura);
    resultado = temperatura * 1.8 + 32 ;
    printf("Resultado: %.3f", resultado);
    break;
    
    case 2:
    printf("Digite os graus da temperatura: ");
    scanf("%f", &temperatura);
    resultado = temperatura + 273.15 ;
    printf("Resultado: %.3f", resultado);
    break;
    
    case 3:
    printf("Digite os graus da temperatura: ");
    scanf("%f", &temperatura);
    resultado = (temperatura - 32) * (5.0/9.0);
    printf("Resultado: %.3f", resultado);
    break;
    
    case 4:
    printf("Digite os graus da temperatura: ");
    scanf("%f", &temperatura);
    resultado = (temperatura - 32) * (5.0/9.0) + 273.15;
    printf("Resultado: %.3f", resultado);
    break;
    
    case 5:
    printf("Digite os graus da temperatura: ");
    scanf("%f", &temperatura);
    resultado = (temperatura - 273.15);
    printf("Resultado: %.3f", resultado);
    break;
    
    case 6:
    printf("Digite os graus da temperatura: ");
    scanf("%f", &temperatura);
    resultado = (temperatura - 273.15) * (9.0/5.0) + 32;
    printf("Resultado: %.3f", resultado);
    break; 
    
    
    default:
    printf("Opção inválida");
    
}

 return 0;
}
